{
  "name": "stkpatch",
  "description": "subtractive patch built from STK generators: saw/square crossfade, detuned second saw, sine sub, noise, BiQuad filter with envelope, ADSR amp, echo, JCRev",
  "sampleRate": 22050,
  "protocol": { "duration": 1.2, "gate": 0.6, "velocity": 1.0, "midiMin": 36, "midiMax": 84 },
  "params": [
    { "name": "wave",        "type": "float",  "min": 0,    "max": 1,    "scale": "linear" },
    { "name": "osc2Level",   "type": "float",  "min": 0,    "max": 1,    "scale": "linear" },
    { "name": "osc2Detune",  "type": "float",  "min": 0,    "max": 40,   "scale": "linear", "unit": "cents" },
    { "name": "subLevel",    "type": "float",  "min": 0,    "max": 1,    "scale": "linear" },
    { "name": "noiseLevel",  "type": "float",  "min": 0,    "max": 0.4,  "scale": "linear" },
    { "name": "filterType",  "type": "choice", "choices": ["lowpass", "bandpass", "highpass"] },
    { "name": "cutoff",      "type": "float",  "min": 80,   "max": 8000, "scale": "log", "unit": "Hz" },
    { "name": "resonance",   "type": "float",  "min": 0.5,  "max": 10,   "scale": "log", "unit": "Q" },
    { "name": "envAmount",   "type": "float",  "min": 0,    "max": 4,    "scale": "linear", "unit": "octaves" },
    { "name": "envDecay",    "type": "float",  "min": 0.02, "max": 1.0,  "scale": "log", "unit": "s" },
    { "name": "attack",      "type": "float",  "min": 0.002,"max": 0.4,  "scale": "log", "unit": "s" },
    { "name": "decay",       "type": "float",  "min": 0.02, "max": 1.0,  "scale": "log", "unit": "s" },
    { "name": "sustain",     "type": "float",  "min": 0,    "max": 1,    "scale": "linear" },
    { "name": "release",     "type": "float",  "min": 0.02, "max": 0.6,  "scale": "log", "unit": "s" },
    { "name": "echoTime",    "type": "float",  "min": 0.05, "max": 0.4,  "scale": "linear", "unit": "s" },
    { "name": "echoMix",     "type": "float",  "min": 0,    "max": 0.5,  "scale": "linear" },
    { "name": "reverbTime",  "type": "float",  "min": 0.2,  "max": 3,    "scale": "log", "unit": "s" },
    { "name": "reverbMix",   "type": "float",  "min": 0,    "max": 0.5,  "scale": "linear" }
  ]
}
